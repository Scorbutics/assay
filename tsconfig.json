{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "@scorbutics/assay-seam": [
        "./packages/assay-seam/src/ledger.ts"
      ],
      "@scorbutics/assay-seam/shape": [
        "./packages/assay-seam/src/shape.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts"
  ]
  // NOTE: no `baseUrl` — it is deprecated in TypeScript 7, and `deno publish`
  // reads this file and fails on it. `paths` resolves relative to this file
  // without it.
  //
  // `paths` resolves the sibling package for THIS repo's own typecheck
  // only. packages/assay declares it as `file:../assay-seam` so a consumer
  // installing from outside this workspace resolves it — and bun then declines
  // to symlink it inside the workspace, since it is also a workspace member.
  // Consumers are unaffected: they get a real link, or a real published package.
}
