{
  "name": "@scorbutics/assay-seam",
  "version": "0.4.2",
  "description": "The runtime seam: records what a backend operation touches, as shapes, without recording values.",
  "license": "MIT",
  "type": "module",
  "main": "./src/ledger.ts",
  "exports": {
    ".": "./src/ledger.ts",
    "./shape": "./src/shape.ts",
    "./template": "./src/template.ts",
    "./async-context": {
      "browser": "./src/async-context.browser.ts",
      "default": "./src/async-context.ts"
    }
  },
  "browser": {
    "./src/async-context.ts": "./src/async-context.browser.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "supabase",
    "deno",
    "postgrest",
    "observability",
    "testing"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
